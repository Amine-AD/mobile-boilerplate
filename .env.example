# Copy to .env.local and fill in what you use. Every service is optional — missing keys disable that feature.
# EXPO_PUBLIC_* values are bundled into the app and readable by anyone: public keys only, never secrets.

# RevenueCat (in-app purchases) — Project settings > API keys > public app-specific keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# PostHog (analytics, error tracking, feature flags)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Convex (optional backend) — written automatically by `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=
